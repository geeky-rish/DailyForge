# DailyForge Backend — Environment Variables
# Copy to .env and fill in real values. Never commit .env.

# --- Application ---
APP_ENV=development                         # development | production
SECRET_KEY=change_me_to_a_random_64_char_hex_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/dailyforge
# For SQLite in dev (simpler setup):
# DATABASE_URL=sqlite:///./dailyforge_dev.db

# --- GitHub OAuth ---
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

# --- Authorized User ---
# After first login run: python scripts/print_github_user_id.py
AUTHORIZED_GITHUB_USERNAME=geeky-rish
AUTHORIZED_GITHUB_USER_ID=your_numeric_github_user_id

# --- GitHub Profile README write token ---
# Create a Fine-Grained PAT with repo:contents write on geeky-rish/geeky-rish only
GITHUB_WRITE_TOKEN=github_pat_your_token_here
GITHUB_README_REPO=geeky-rish/geeky-rish

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# You can use SMTP_EMAIL or SMTP_USER:
SMTP_EMAIL=learn.rishipk@gmail.com
# Google App Password (16 characters, no spaces):
SMTP_APP_PASSWORD=your_16_char_google_app_password
# Recipient email address:
RECIPIENT_EMAIL=hello.rishikulkarni@gmail.com
# Optional aliases:
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# EMAIL_FROM=your_email@gmail.com
# EMAIL_TO=your_email@gmail.com
SMTP_TLS=true
EMAIL_DRY_RUN=false   # Set true to skip real delivery; logs instead

# --- Frontend URL (CORS) ---
FRONTEND_URL=http://localhost:5173
# Production: FRONTEND_URL=https://geeky-rish.github.io/dailyforge

# --- Challenge Config ---
CHALLENGE_START_DATE=2024-01-01   # YYYY-MM-DD, local time Asia/Kolkata
TIMEZONE=Asia/Kolkata
QUESTIONS_PER_DAY=2

# --- Render (deployment) ---
# PORT is auto-set by Render. Do not set manually.
